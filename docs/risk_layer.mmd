  classDef gate fill:#FFF6E8,stroke:#B0761A,stroke-width:1.4px,color:#5A3B06;
  classDef t1 fill:#E9F4EC,stroke:#2E6B4A,stroke-width:1.5px,color:#14342A;
  classDef t2 fill:#EDF2F9,stroke:#3E6394,stroke-width:1.5px,color:#1B3357;
  classDef t3 fill:#FBECEC,stroke:#A83232,stroke-width:1.5px,color:#5E1414;
  classDef route fill:#F6EFF7,stroke:#7A4E96,stroke-width:1.4px,color:#3A2350;

  class F,W io;
  class G,Q,M gate;
  class T1 t1;
  class T2 t2;
  class T3 t3;
  class SF,VU,DNE route;
