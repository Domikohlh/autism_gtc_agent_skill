flowchart TD

  IN(["<b>INPUT</b> — a report PDF, pasted text or a VCF,<br/>or just a gene symbol and a clinical question"])

  S1["<b>1 · Parse the report</b><br/>gene · HGVS · classification · zygosity · CNVs · repeats · assay · report date<br/>identifiers are redacted on the way in"]

  S2["<b>2 · Look up what is established</b><br/>gene, syndrome name or cytoband → care domains, traps, sources to fetch<br/>the index holds no ages and no doses, by design"]

  S3["<b>3 · Fetch the named sources</b><br/>GeneReviews · ClinGen · ClinVar · OMIM · guidelines · patient organisations<br/>read the current specifics and stamp a retrieval date"]

  S4["<b>4 · Apply the risk layer</b><br/>Tier 1 / Tier 2 / Tier 3, plus VUS, secondary findings and minors<br/>see risk_layer.png for the decision"]

  S5["<b>5 · Work out the testing gap</b><br/>what this assay could not have found · what is indicated · whose authority<br/>reanalysis or a new test — never eligibility"]

  S6["<b>6 · Write both registers</b><br/>one for the family, one for the clinician<br/>the PHI check blocks the write"]

  OUT(["<b>OUTPUT — brief.md</b><br/>every clinical specific carries a source and a retrieval date"])

  IN --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> OUT

  L["<b>What runs each step · what governs it</b><br/><i>scripts/ and references/ prefixes omitted below</i><br/><br/><b>1</b>  parse_report.py — <i>report_parsing.md</i><br/><b>2</b>  gene_lookup.py + assets/gene_index.json <i>(27 genes + 2 aliases · 5 CNV regions)</i> — <i>gene_index.md</i><br/><b>3</b>  no script — you fetch and read<br/><b>4</b>  no script, policy only — <i>risk_layer_policy.md</i> · <i>vus_communication.md</i><br/><b>5</b>  indication_lookup.py + assets/indication_index.json — <i>testing_indications.md</i> · <i>request_templates.md</i><br/><b>6</b>  render_brief.py + phi.py — <i>output_templates.md</i><br/><br/><i>Separate entry point: plain_language.py — putting a clinician's document into plain language for a family. Joins the pipeline at step 6.</i>"]

  OUT ~~~ L

  classDef io fill:#E9F4EC,stroke:#2E6B4A,stroke-width:1.5px,color:#14342A;
  classDef step fill:#F4F6F9,stroke:#5B7A99,stroke-width:1.2px,color:#1F2933;
  classDef fetch fill:#FFF6E8,stroke:#B0761A,stroke-width:1.2px,color:#5A3B06;
  classDef risk fill:#F6EFF7,stroke:#7A4E96,stroke-width:1.5px,color:#3A2350;
  classDef leg fill:#FFFFFF,stroke:#DDE3EA,stroke-width:1px,color:#4A5560;

  class IN,OUT io;
  class S1,S2,S5,S6 step;
  class S3 fetch;
  class S4 risk;
  class L leg;
