__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
.idea/
.vscode/

# Build output of scripts/bundle_skill.py — regenerate it, don't commit it.
dist/

# Never commit real reports or anything derived from them.
# This project touches health data; keep it out of version control by default.
*.vcf
*.vcf.gz
reports/
patient_data/
findings*.json
brief*.md
!docs/**

# The synthetic test corpus is the one exception, and it is only an exception
# because every patient, laboratory and record number in it is invented. Nothing
# real goes in here — put working copies of real reports anywhere else, where the
# rules above still apply.
!tests/fixtures/
!tests/fixtures/vcf/
!tests/fixtures/*.txt
!tests/fixtures/vcf/*.vcf
!tests/fixtures/vcf/*.txt